<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Animated arena backdrop drawn by a custom view. -->
    <com.arena3.ui.MenuBackdropView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp">

        <!-- Left column: identity + primary actions -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="start|center_vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text"
                android:textSize="52sp"
                android:letterSpacing="0.22"
                android:textStyle="bold"
                android:shadowColor="@color/accent"
                android:shadowRadius="18"
                android:shadowDx="0"
                android:shadowDy="0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tagline"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:letterSpacing="0.5"
                android:layout_marginBottom="26dp" />

            <Button
                android:id="@+id/btn_fight"
                android:layout_width="220dp"
                android:layout_height="54dp"
                android:text="@string/fight"
                android:textColor="#FF120C02"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.2"
                android:background="@drawable/btn_primary"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btn_settings"
                android:layout_width="220dp"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:text="@string/settings"
                android:textColor="@color/text"
                android:textSize="14sp"
                android:letterSpacing="0.2"
                android:background="@drawable/btn_secondary"
                android:stateListAnimator="@null" />

            <TextView
                android:id="@+id/about"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/about_body"
                android:textColor="@color/text_dim"
                android:textSize="10sp"
                android:lineSpacingMultiplier="1.35" />
        </LinearLayout>

        <!-- Right column: match setup -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_panel"
                android:padding="16dp">

                <TextView
                    style="@style/Label"
                    android:text="@string/arena" />

                <LinearLayout
                    android:id="@+id/map_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false" />

                <TextView
                    android:id="@+id/lbl_bots"
                    style="@style/Label"
                    android:text="@string/opponents" />

                <SeekBar
                    android:id="@+id/sb_bots"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="6"
                    android:progress="2" />

                <TextView
                    android:id="@+id/lbl_skill"
                    style="@style/Label"
                    android:text="@string/skill" />

                <SeekBar
                    android:id="@+id/sb_skill"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="4"
                    android:progress="2" />

                <TextView
                    android:id="@+id/lbl_frags"
                    style="@style/Label"
                    android:text="@string/frag_limit" />

                <SeekBar
                    android:id="@+id/sb_frags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="10"
                    android:progress="3" />

                <TextView
                    android:id="@+id/lbl_time"
                    style="@style/Label"
                    android:text="@string/time_limit" />

                <SeekBar
                    android:id="@+id/sb_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="6"
                    android:progress="2" />

                <TextView
                    android:id="@+id/map_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/text_dim"
                    android:textSize="10sp"
                    android:lineSpacingMultiplier="1.3" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
