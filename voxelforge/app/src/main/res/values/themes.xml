<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.VoxelForge" parent="Theme.AppCompat.NoActionBar">
        <item name="android:colorBackground">#0B0E14</item>
        <item name="android:windowBackground">#0B0E14</item>
    </style>

    <!--
      Полноэкранная тема для игровой Activity.
      windowBackground оставлен тёмным, чтобы первый кадр до инициализации
      GL-контекста не мигал белым — на медленных устройствах эта вспышка
      заметна и выглядит как сбой.
    -->
    <style name="Theme.VoxelForge.Fullscreen" parent="Theme.VoxelForge">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="27">shortEdges</item>
    </style>
</resources>
