<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      Тема наследуется от системной, а не от библиотеки совместимости.
      Игра не использует ни одного элемента AppCompat — весь интерфейс
      рисуется в OpenGL, — поэтому зависимость от неё была бы лишней
      точкой отказа при старте на нестандартных прошивках.

      Тёмный фон задан явно: первый кадр до создания контекста GL иначе
      мигает белым, и на медленных устройствах эта вспышка читается как сбой.
    -->
    <style name="Theme.VoxelForge" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:colorBackground">#0B0E14</item>
        <item name="android:windowBackground">#0B0E14</item>
    </style>

    <style name="Theme.VoxelForge.Fullscreen" parent="Theme.VoxelForge">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="27">shortEdges</item>
    </style>
</resources>
